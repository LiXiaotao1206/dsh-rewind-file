{
  "name": "dsh-rewind-file",
  "version": "0.1.0",
  "description": "Restore workspace files when dsh's /rewind forks a session: side bare-git repo + write-tree snapshots at every step/end + per-file checkout on the rewind boundary (opencode's undo/redo mechanism). No new commands — it rides the existing rewind.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rewind",
    "snapshot",
    "workspace",
    "restore",
    "opencode",
    "cordis-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lixiaotao/dsh-rewind-file.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "permissions": [
      "workspace:read",
      "workspace:write",
      "git:read",
      "git:write",
      "network:none"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.1-rc.2"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
